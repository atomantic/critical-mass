# Critical Mass — gateway/UI/script environment variables
# Copy this file to .env and fill in values before starting the server.
# Note: engine process wrapper variables (e.g. EXCHANGE_NAME, EXCHANGE_IPC_PORT)
# supplied at runtime are not exhaustively documented here.

# ── Server ─────────────────────────────────────────────────────────────────────

# TCP port the Express/Socket.IO gateway listens on (default: 5570)
PORT=5570

# Bind address(es). After operator setup, the default is 127.0.0.1 plus any
# Tailscale 100.64/10 IPs. Before setup, the gateway binds loopback-only unless
# OPERATOR_BOOTSTRAP_SECRET is configured. Comma-separated to pin hosts;
# 0.0.0.0 binds every interface only after auth or remote bootstrap is available.
# HOST=127.0.0.1

# Optional one-time credential for enrolling the first operator password over a
# non-loopback connection. Must be at least 32 bytes. Generate out of band, for
# example: openssl rand -hex 32. Never commit the value or place it in a URL.
# OPERATOR_BOOTSTRAP_SECRET=
# OPERATOR_BOOTSTRAP_SECRET_FILE is managed internally by container startup.

# Comma-separated extra CORS origins. *.ts.net and 100.64/10 are always allowed.
# CORS_ORIGINS=http://localhost:5570,http://localhost:5571

# Comma-separated exact origins that AI API providers may contact
# AI_ALLOWED_ENDPOINTS=https://api.openai.com,https://api.anthropic.com

# Comma-separated workspace roots available to AI runs (default: repository root)
# AI_WORKSPACE_ROOTS=/path/to/critical-mass

# ── IPC ports (gateway ↔ engine) ───────────────────────────────────────────────

# Port the Coinbase engine IPC server listens on (default: 5570)
COINBASE_IPC_PORT=5570

# Port the Gemini engine IPC server listens on (default: 5571)
GEMINI_IPC_PORT=5571

# Port the Crypto.com engine IPC server listens on (default: 5574)
CRYPTOCOM_IPC_PORT=5574

# ── Admin UI (Vite dev server) ──────────────────────────────────────────────────

# Port the Vite dev server listens on (default: 5571)
VITE_PORT=5571

# Gateway API port Vite proxies /api requests to (default: 5570)
VITE_API_PORT=5570

# ── Scripts ────────────────────────────────────────────────────────────────────

# Gateway base URL used by utility scripts (default: http://localhost:5570)
GATEWAY_URL=http://localhost:5570
