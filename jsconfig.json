{
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "target": "ES2024",
    "resolveJsonModule": true,
    "module": "NodeNext",
    "types": ["node"],
    "paths": {
      "*": [
        "./*"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "engines/**/*.js",
    "shared/**/*.mjs",
    "scripts/**/*.js",
    "server.js",
    "index.js"
  ],
  "exclude": [
    "node_modules",
    "admin"
  ]
}
