{
  "name": "critical-mass",
  "version": "2.31.0",
  "description": "Multi-exchange BTC accumulation engine with celestial position management",
  "main": "index.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "node scripts/pm2-stack.js start",
    "dev": "node scripts/dev.js",
    "dev:server": "node scripts/dev.js server",
    "dev:ui": "node scripts/dev.js ui",
    "build": "cd admin && npm run build",
    "test:docker-storage": "scripts/docker-storage-smoke-test.sh",
    "test:docker-seed": "scripts/docker-seed-config-smoke-test.sh",
    "test:docker-stop-order": "scripts/docker-stop-order-smoke-test.sh",
    "pm2:start": "node scripts/pm2-stack.js start",
    "pm2:stop": "node scripts/pm2-stack.js stop",
    "pm2:restart": "node scripts/pm2-stack.js start",
    "pm2:logs": "pm2 logs critical-mass",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "cli": "node index.js",
    "cli:status": "node index.js status",
    "cli:debug": "node index.js debug",
    "admin:install": "cd admin && npm install",
    "install:all": "npm install && cd admin && npm install",
    "test": "node scripts/test.js",
    "test:watch": "node scripts/test.js --watch",
    "test:changed": "node scripts/test.js --changed",
    "test:browser-smoke": "node scripts/admin-react19-browser-smoke.js",
    "test:admin": "npm test --prefix admin",
    "lint:admin": "npm run lint --prefix admin",
    "test:all": "npm test && npm run test:admin",
    "typecheck": "node scripts/typecheck.js",
    "check": "npm run test:all && npm run lint:admin && npm run typecheck && npm run build"
  },
  "keywords": [
    "coinbase",
    "gemini",
    "dca",
    "trading",
    "btc",
    "usdc",
    "portos",
    "critical-mass"
  ],
  "author": "Adam Eivy (@antic|@atomantic)",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.11",
    "typescript": "7.0.2"
  }
}
