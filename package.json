{
  "name": "critical-mass",
  "version": "2.27.0",
  "description": "Multi-exchange BTC accumulation engine with celestial position management",
  "main": "index.js",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "start": "node scripts/pm2-stack.js start",
    "dev": "node scripts/dev.js",
    "dev:server": "VITE_API_PORT=5570 node --watch server.js",
    "dev:ui": "cd admin && VITE_PORT=5571 VITE_API_PORT=5570 npm run dev",
    "build": "cd admin && npm run build",
    "test:docker-storage": "scripts/docker-storage-smoke-test.sh",
    "test:docker-seed": "scripts/docker-seed-config-smoke-test.sh",
    "pm2:start": "node scripts/pm2-stack.js start",
    "pm2:stop": "node scripts/pm2-stack.js stop",
    "pm2:restart": "node scripts/pm2-stack.js start",
    "pm2:logs": "pm2 logs critical-mass",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "cli": "node index.js",
    "cli:status": "node index.js status",
    "cli:debug": "node index.js debug",
    "admin:install": "cd admin && npm install",
    "install:all": "npm install && cd admin && npm install",
    "test": "node scripts/test.js"
  },
  "keywords": [
    "coinbase",
    "gemini",
    "dca",
    "trading",
    "btc",
    "usdc",
    "portos",
    "critical-mass"
  ],
  "author": "Adam Eivy (@antic|@atomantic)",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "express": "5.3.0",
    "portos-ai-toolkit": "0.8.4"
  }
}
